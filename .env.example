# Proposed local configuration; application loaders are not implemented yet.
# Copy to .env for local use. Never add real secrets to this example.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./malttuk.db
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
# Public browser configuration only; never put secrets in VITE_* variables.
# Use only if the frontend adopts Vite.
VITE_API_BASE_URL=http://localhost:8000
# Android emulator host access commonly uses 10.0.2.2; configure separately.
