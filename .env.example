# Proposed local server configuration. Confirm names with the JVM server setup.
# Copy to .env for local use. Never add real secrets to this example.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
# DATABASE_URL and upload storage configuration depend on the selected stack.

# Optional API smoke-test credentials. Set in the invoking terminal.
# The smoke script does not load .env automatically. Never commit real tokens.
# MALTTUK_SENDER_TOKEN=
# MALTTUK_RECIPIENT_TOKEN=
