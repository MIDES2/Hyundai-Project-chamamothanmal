# Local prototype only. Run services/api/scripts/init-local.ps1 to create private .env.
# Spring imports root .env and services/api/.env as UTF-8 properties, without quotes.
# Never put these tokens in browser build-time variables or commit actual .env.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
API_DB_URL=jdbc:h2:file:./data/messages;DB_CLOSE_ON_EXIT=FALSE
API_DB_USER=sa
API_DB_PASSWORD=
API_UPLOAD_DIR=./uploads
API_TIMEZONE=Asia/Seoul
API_MAX_AUDIO_BYTES=5242880
API_MAX_AUDIO_SECONDS=15
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Three distinct random URL-safe tokens, at least 32 characters. Empty fails closed.
API_SENDER_TOKEN=
API_RECIPIENT_TOKEN=
API_OTHER_RECIPIENT_TOKEN=

# Final proposal v3: default stays local, existing private .env is not overwritten.
API_AUTH_MODE=local
API_STORAGE_MODE=local
API_CLEANUP_ENABLED=true
# Supabase project origin (HTTPS, no trailing path); publishable key or legacy anon key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# LEGACY service_role JWT: backend only, NEVER frontend/APK/GitHub. Used for private objects and Auth deletion.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=voices
# Use the dashboard Connect values. Dedicated test project recommended.
# Example: jdbc:postgresql://HOST:5432/postgres?sslmode=verify-full&sslrootcert=C:/certs/supabase-ca.crt&currentSchema=chamamothanmal
SUPABASE_DB_URL=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
# Opt in at launch: gradlew.bat bootRun --args="--spring.profiles.active=supabase"
# Do not set SPRING_PROFILES_ACTIVE globally; local checks must not target a cloud DB.

# Kakao Local keyword/address search. REST API key stays on the backend, never in web/APK.
KAKAO_REST_API_KEY=
