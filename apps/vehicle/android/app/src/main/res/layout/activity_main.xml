<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/main"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="#F5F7FA">

  <ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="32dp">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#182230"
        android:textSize="32sp"
        android:textStyle="bold" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="차 안에서 함께 듣는 마음"
        android:textColor="#526071"
        android:textSize="20sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="#E8EDF3"
        android:padding="20dp"
        android:text="차량 상태 미확인 · 재생 보류"
        android:textColor="#344054"
        android:textSize="20sp" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="받은 메시지"
        android:textColor="#182230"
        android:textSize="24sp"
        android:textStyle="bold" />

      <LinearLayout
        android:id="@+id/messageCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="24dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="발표회에 도착하면 들어요"
          android:textColor="#182230"
          android:textSize="24sp"
          android:textStyle="bold" />

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:text="목적지: 테스트 발표회장"
          android:textColor="#526071"
          android:textSize="20sp" />

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:text="화면 확인용 테스트 메시지입니다."
          android:textColor="#526071"
          android:textSize="18sp" />

      </LinearLayout>

    </LinearLayout>

  </ScrollView>

</LinearLayout>
